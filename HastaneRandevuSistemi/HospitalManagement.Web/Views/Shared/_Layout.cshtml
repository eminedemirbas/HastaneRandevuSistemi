<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedPoint Sağlık Portalı</title>

    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Proje Özel Teması -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- Üst Kurumsal Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark-navy shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon bg-primary text-white rounded-3 p-2 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-hospital fs-5"></i>
                    </span>
                    <span>Med<span class="text-primary">Point</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Ana Sayfa
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Appointment" asp-action="MyAppointments">
                                    <i class="bi bi-calendar2-check me-1"></i> Randevularım
                                </a>
                            </li>

                            @if (User.IsInRole("Doctor") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3 text-info fw-semibold" asp-controller="Doctor" asp-action="Appointments">
                                        <i class="bi bi-person-badge me-1"></i> Doktor Paneli
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3 text-warning fw-semibold" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock me-1"></i> Yönetici Paneli
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Kullanıcı Giriş / Profil Alanı -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <div class="user-chip d-flex align-items-center gap-2 bg-white bg-opacity-10 text-white rounded-pill px-3 py-1">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span class="small fw-medium">@User.Identity.Name</span>
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> Çıkış
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Kayıt Ol
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Ana İçerik -->
    <main role="main" class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Kurumsal Footer -->
    <footer class="bg-white border-top py-4 mt-auto">
        <div class="container text-center text-muted small">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    &copy; @DateTime.Now.Year <strong>MedPoint Sağlık Randevu Portalı</strong> - Tüm Hakları Saklıdır.
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="badge bg-light text-dark border">ASP.NET Core MVC &bull; .NET 8</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scriptler -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>