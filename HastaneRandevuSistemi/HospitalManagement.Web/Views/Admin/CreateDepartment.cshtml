@model HospitalManagement.Core.Entities.Department
@{
    ViewData["Title"] = "Bölüm Ekle";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white"><h5>Yeni Bölüm Ekle</h5></div>
            <div class="card-body">
                <form asp-action="CreateDepartment" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Bölüm Adı</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>