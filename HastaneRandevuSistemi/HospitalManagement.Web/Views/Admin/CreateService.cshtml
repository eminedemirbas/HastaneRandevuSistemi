@model HospitalManagement.Core.Entities.MedicalService
@{
    ViewData["Title"] = "Hizmet Ekle";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-info text-white"><h5>@ViewBag.DepartmentName Bölümüne Hizmet Ekle</h5></div>
            <div class="card-body">
                <form asp-action="CreateService" method="post">
                    <input type="hidden" asp-for="DepartmentId" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Hizmet Adı (Örn: EKG, Dolgu)</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="DurationInMinutes" class="form-label">Süre (Dakika)</label>
                        <input asp-for="DurationInMinutes" type="number" class="form-control" placeholder="15" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Ücret (TL)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="500.00" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>