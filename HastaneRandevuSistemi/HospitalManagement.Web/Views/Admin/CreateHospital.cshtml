@model HospitalManagement.Core.Entities.Hospital
@{
    ViewData["Title"] = "Hastane Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white"><h5>Yeni Hastane Tanımla</h5></div>
            <div class="card-body">
                <form asp-action="CreateHospital" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Kurum Adı</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="City" class="form-label">Şehir</label>
                        <input asp-for="City" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Telefon</label>
                        <input asp-for="PhoneNumber" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Adres</label>
                        <textarea asp-for="Address" class="form-control" rows="2" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>