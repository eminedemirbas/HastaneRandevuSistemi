@model IEnumerable<HospitalManagement.Core.Entities.Appointment>
@using HospitalManagement.Core.Enums

@{
    ViewData["Title"] = "Randevu Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0">Hasta Randevu Takibi</h3>
        <small class="text-muted">Hoş geldiniz, @ViewBag.DoctorName</small>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">Henüz adınıza kayıtlı bir randevu bulunmamaktadır.</div>
        }
        else
        {
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Tarih & Saat</th>
                        <th>Hasta Adı</th>
                        <th>İşlem / Hizmet</th>
                        <th>Süre</th>
                        <th>Ücret</th>
                        <th>Hasta Notu</th>
                        <th>Durum</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.AppointmentDate.ToString("dd.MM.yyyy")</strong><br>
                                <span class="badge bg-light text-dark border">@item.AppointmentDate.ToString("HH:mm") - @item.EndDate.ToString("HH:mm")</span>
                            </td>
                            <td>
                                <strong>@item.Patient.FullName</strong><br>
                                <small class="text-muted">@item.Patient.Email</small>
                            </td>
                            <td>@item.MedicalService.Name</td>
                            <td>@((item.EndDate - item.AppointmentDate).TotalMinutes) dk</td>
                            <td>@item.Price.ToString("C2")</td>
                            <td>
                                @(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case AppointmentStatus.Pending:
                                        <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                                        break;
                                    case AppointmentStatus.Approved:
                                        <span class="badge bg-success">Onaylandı</span>
                                        break;
                                    case AppointmentStatus.Cancelled:
                                        <span class="badge bg-danger">İptal Edildi</span>
                                        break;
                                    case AppointmentStatus.Completed:
                                        <span class="badge bg-primary">Tamamlandı</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    @if (item.Status == AppointmentStatus.Pending)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="@AppointmentStatus.Approved" />
                                            <button type="submit" class="btn btn-sm btn-success me-1">Onayla</button>
                                        </form>

                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="@AppointmentStatus.Cancelled" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger me-1">Reddet</button>
                                        </form>
                                    }
                                    else if (item.Status == AppointmentStatus.Approved)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="@AppointmentStatus.Completed" />
                                            <button type="submit" class="btn btn-sm btn-primary me-1">Tamamlandı Olarak İşaretle</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>